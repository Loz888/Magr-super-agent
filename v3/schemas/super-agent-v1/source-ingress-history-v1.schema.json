{
  "$defs": {
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Source Kind",
          "type": "string"
        },
        "source_instance_id": {
          "format": "uuid",
          "title": "Source Instance Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "installation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Installation Id",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "source_instance_id",
        "tenant_id",
        "installation_id"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "SourceThreadRef": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "conversation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "native_thread_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Thread Id"
        }
      },
      "required": [
        "scope",
        "conversation_id"
      ],
      "title": "SourceThreadRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_thread": {
      "$ref": "#/$defs/SourceThreadRef"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "limit": {
      "default": 100,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "source_thread"
  ],
  "title": "HistoryRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
