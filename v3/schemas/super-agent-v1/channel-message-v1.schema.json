{
  "$defs": {
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Source Kind",
          "type": "string"
        },
        "source_instance_id": {
          "format": "uuid",
          "title": "Source Instance Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "installation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Installation Id",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "source_instance_id",
        "tenant_id",
        "installation_id"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "SourceThreadRef": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "conversation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "native_thread_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Thread Id"
        }
      },
      "required": [
        "scope",
        "conversation_id"
      ],
      "title": "SourceThreadRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only a Dispatcher with a current authorized Action may use this port.",
  "properties": {
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "destination": {
      "$ref": "#/$defs/SourceThreadRef"
    },
    "payload_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "body_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Body Ref",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "destination",
    "payload_hash",
    "body_ref",
    "idempotency_key"
  ],
  "title": "ChannelMessage",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
