{
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "review_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Review Ref",
      "type": "string"
    },
    "input_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Input Ids",
      "type": "array"
    },
    "reason_code": {
      "default": "NEEDS_ROUTING",
      "enum": [
        "NEEDS_ROUTING",
        "OUT_OF_SCOPE",
        "TARGET_CLOSED"
      ],
      "title": "Reason Code",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "snapshot_sha256",
    "review_ref",
    "input_ids"
  ],
  "title": "SubscriptionHandbackRequest",
  "type": "object"
}
