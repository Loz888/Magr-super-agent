{
  "$defs": {
    "CorrelationInputRef": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "format": "uuid",
          "title": "Input Id",
          "type": "string"
        },
        "source_instance_id": {
          "format": "uuid",
          "title": "Source Instance Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "version_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Version Fingerprint",
          "type": "string"
        },
        "state_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "State Sha256",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "source_instance_id",
        "project_id",
        "version_fingerprint",
        "state_sha256"
      ],
      "title": "CorrelationInputRef",
      "type": "object"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "properties": {
        "cpu_millis": {
          "maximum": 2000,
          "minimum": 100,
          "title": "Cpu Millis",
          "type": "integer"
        },
        "memory_mib": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Memory Mib",
          "type": "integer"
        }
      },
      "required": [
        "cpu_millis",
        "memory_mib"
      ],
      "title": "ResourceRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "expected_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Expected Epoch",
      "type": "integer"
    },
    "target_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Target Sha256",
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/ResourceRequest"
    },
    "source_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorrelationInputRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Review Ref",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "expected_epoch",
    "target_sha256",
    "resources",
    "review_ref"
  ],
  "title": "SchedulerEnqueueRequest",
  "type": "object"
}
