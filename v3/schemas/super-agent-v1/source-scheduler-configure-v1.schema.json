      "title": "SchedulerLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "configuration": {
      "$ref": "#/$defs/SchedulerConfiguration"
    },
    "review_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Review Ref",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "configuration",
    "review_ref"
  ],
  "title": "SchedulerConfigureRequest",
  "type": "object"
}
