{
  "$defs": {
    "TargetRef": {
      "additionalProperties": false,
      "properties": {
        "ticket_id": {
          "format": "uuid",
          "title": "Ticket Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        },
        "thread_revision": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Thread Revision",
          "type": "integer"
        },
        "execution_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Execution Epoch",
          "type": "integer"
        },
        "mandate_id": {
          "format": "uuid",
          "title": "Mandate Id",
          "type": "string"
        },
        "mandate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Mandate Sha256",
          "type": "string"
        },
        "project_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "ticket_id",
        "run_id",
        "thread_id",
        "thread_revision",
        "execution_epoch",
        "mandate_id",
        "mandate_sha256",
        "project_id",
        "repository",
        "allowed"
      ],
      "title": "TargetRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "source-correlation-v1",
      "default": "source-correlation-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "input_id": {
      "format": "uuid",
      "title": "Input Id",
      "type": "string"
    },
    "unit_key": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Unit Key",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "matched",
        "unmatched",
        "ambiguous",
        "blocked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "EXACT_RESOURCE",
        "NO_EXPLICIT_RESOURCE",
        "RESOURCE_UNCLAIMED",
        "RESOURCE_AMBIGUOUS",
        "RESOURCE_CONFLICT",
        "RESOURCE_REMOVED",
        "TARGET_UNAVAILABLE",
        "TARGET_DENIED",
        "SUGGESTION_ONLY"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "resource_keys": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Resource Keys",
      "type": "array"
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TargetRef"
      },
      "maxItems": 3,
      "title": "Candidates",
      "type": "array"
    },
    "suggestion_decision_key": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggestion Decision Key"
    },
    "eligible_for_execution": {
      "const": false,
      "default": false,
      "title": "Eligible For Execution",
      "type": "boolean"
    },
    "executes_tasks": {
      "const": false,
      "default": false,
      "title": "Executes Tasks",
      "type": "boolean"
    },
    "calls_model": {
      "const": false,
      "default": false,
      "title": "Calls Model",
      "type": "boolean"
    },
    "external_writes": {
      "const": 0,
      "default": 0,
      "title": "External Writes",
      "type": "integer"
    }
  },
  "required": [
    "input_id",
    "unit_key",
    "snapshot_sha256",
    "outcome",
    "reason_code",
    "resource_keys"
  ],
  "title": "CorrelationResolution",
  "type": "object"
}
