        "chat_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Chat Id",
          "type": "string"
        },
        "thread_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Thread Id",
          "type": "string"
