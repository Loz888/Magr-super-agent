{
  "$defs": {
    "AsyncRestriction": {
      "additionalProperties": false,
      "description": "Only deny sets grow; no field can grant paths, commands, network or payment.",
      "properties": {
        "deny_write_paths": {
          "default": [],
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Deny Write Paths",
          "type": "array"
        },
        "deny_commands": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Deny Commands",
          "type": "array"
        }
      },
      "title": "AsyncRestriction",
      "type": "object"
    },
    "AsyncScope": {
      "additionalProperties": false,
      "properties": {
        "coding_id": {
          "format": "uuid",
          "title": "Coding Id",
          "type": "string"
        },
        "coding_revision": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Coding Revision",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/CodingTarget"
        },
        "assignment_id": {
          "format": "uuid",
          "title": "Assignment Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "mandate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Mandate Sha256",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "initial_context_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Initial Context Sha256",
          "type": "string"
        },
        "control_profile_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Profile Sha256"
        }
      },
      "required": [
        "coding_id",
        "coding_revision",
        "target",
        "assignment_id",
        "session_id",
        "workspace_id",
        "epoch",
        "mandate_sha256",
        "profile_sha256",
        "initial_context_sha256"
      ],
      "title": "AsyncScope",
      "type": "object"
    },
    "CodingTarget": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        },
        "ticket_id": {
          "format": "uuid",
          "title": "Ticket Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "mandate_id": {
          "format": "uuid",
          "title": "Mandate Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "thread_id",
        "ticket_id",
        "run_id",
        "mandate_id"
      ],
      "title": "CodingTarget",
      "type": "object"
    },
    "CorrelationInputRef": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "format": "uuid",
          "title": "Input Id",
          "type": "string"
        },
        "source_instance_id": {
          "format": "uuid",
          "title": "Source Instance Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "version_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Version Fingerprint",
          "type": "string"
        },
        "state_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "State Sha256",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "source_instance_id",
        "project_id",
        "version_fingerprint",
        "state_sha256"
      ],
      "title": "CorrelationInputRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "format": "uuid",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "async_id": {
      "format": "uuid",
      "title": "Async Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AsyncScope"
    },
    "stage": {
      "enum": [
        "before_model",
        "after_model",
        "before_tool",
        "before_command",
        "command_poll",
        "before_result"
      ],
      "title": "Stage",
      "type": "string"
    },
    "input_revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Input Revision",
      "type": "integer"
    },
    "through_sequence": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Through Sequence",
      "type": "integer"
    },
    "restriction": {
      "$ref": "#/$defs/AsyncRestriction"
    },
    "source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CorrelationInputRef"
      },
      "maxItems": 64,
      "title": "Source Refs",
      "type": "array"
    },
    "context_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "tree_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Tree Sha256",
      "type": "string"
    },
    "environment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "checkpoint_id",
    "async_id",
    "scope",
    "stage",
    "input_revision",
    "through_sequence",
    "restriction",
    "context_sha256",
    "tree_sha256",
    "environment_sha256",
    "created_at",
    "expires_at"
  ],
  "title": "AsyncCheckpoint",
  "type": "object"
}
