{
  "$defs": {
    "ComponentObservation": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "format": "uuid",
          "title": "Component Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "source",
            "scheduler",
            "worker",
            "dispatcher",
            "watchdog"
          ],
          "title": "Role",
          "type": "string"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "boot_id": {
          "format": "uuid",
          "title": "Boot Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "starting",
            "ready",
            "degraded",
            "stopping",
            "waiting_runner"
          ],
          "title": "State",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "component_id",
        "role",
        "generation",
        "boot_id",
        "state",
        "expires_at",
        "sequence"
      ],
      "title": "ComponentObservation",
      "type": "object"
    },
    "RunObservation": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting_input",
            "waiting_approval",
            "paused",
            "cancelled",
            "failed",
            "succeeded"
          ],
          "title": "State",
          "type": "string"
        },
        "progress_cursor": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Progress Cursor",
          "type": "integer"
        },
        "progress_at": {
          "format": "date-time",
          "title": "Progress At",
          "type": "string"
        },
        "pending_jobs": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Pending Jobs",
          "type": "integer"
        },
        "overdue_jobs": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Overdue Jobs",
          "type": "integer"
        },
        "expired_assignments": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Expired Assignments",
          "type": "integer"
        },
        "unknown_actions": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Unknown Actions",
          "type": "integer"
        },
        "unknown_calls": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Unknown Calls",
          "type": "integer"
        },
        "job_cursor": {
          "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Job Cursor",
          "type": "string"
        },
        "lease_cursor": {
          "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Lease Cursor",
          "type": "string"
        },
        "unknown_actions_cursor": {
          "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Unknown Actions Cursor",
          "type": "string"
        },
        "unknown_calls_cursor": {
          "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Unknown Calls Cursor",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "epoch",
        "state",
        "progress_cursor",
        "progress_at"
      ],
      "title": "RunObservation",
      "type": "object"
    },
    "SourceObservation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "connection": {
          "enum": [
            "unknown",
            "disabled",
            "online",
            "offline",
            "degraded"
          ],
          "title": "Connection",
          "type": "string"
        },
        "permissions": {
          "enum": [
            "unknown",
            "granted",
            "insufficient",
            "revoked"
          ],
          "title": "Permissions",
          "type": "string"
        },
        "health_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Health At"
        },
        "open_gaps": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Open Gaps",
          "type": "integer"
        },
        "pending_inputs": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Pending Inputs",
          "type": "integer"
        },
        "cursor": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Cursor",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "enabled",
        "connection",
        "permissions",
        "cursor"
      ],
      "title": "SourceObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "source-operations-v1",
      "default": "source-operations-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "config_revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Config Revision",
      "type": "integer"
    },
    "components": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ComponentObservation"
      },
      "maxItems": 16,
      "title": "Components",
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceObservation"
      },
      "maxItems": 100,
      "title": "Sources",
      "type": "array"
    },
    "runs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunObservation"
      },
      "maxItems": 256,
      "title": "Runs",
      "type": "array"
    },
    "runner_available": {
      "default": false,
      "title": "Runner Available",
      "type": "boolean"
    },
    "source_backlog": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Source Backlog",
      "type": "integer"
    },
    "notification_unknown": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Notification Unknown",
      "type": "integer"
    },
    "usage_unknown": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Usage Unknown",
      "type": "integer"
    },
    "redis": {
      "default": "unknown",
      "enum": [
        "unknown",
        "ready",
        "unavailable"
      ],
      "title": "Redis",
      "type": "string"
    },
    "dependency_cursor": {
      "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dependency Cursor",
      "type": "string"
    },
    "backlog_cursor": {
      "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
      "pattern": "^[a-f0-9]{64}$",
      "title": "Backlog Cursor",
      "type": "string"
    },
    "notification_cursor": {
      "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
      "pattern": "^[a-f0-9]{64}$",
      "title": "Notification Cursor",
      "type": "string"
    },
    "usage_cursor": {
      "default": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945",
      "pattern": "^[a-f0-9]{64}$",
      "title": "Usage Cursor",
      "type": "string"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "observed_at",
    "config_revision"
  ],
  "title": "OperationsSnapshot",
  "type": "object"
}
