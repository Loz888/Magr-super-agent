# Example only. Install the real file as root-owned 0600; systemd reads it.
MGAR_V3_DATABASE_URL=postgresql://mgar_sa20:REPLACE_IN_PRIVATE_FILE@127.0.0.1:15432/mgar_sa20
MGAR_V3_REDIS_URL=redis://127.0.0.1:16379/0
MGAR_V3_LOCAL_TOKEN=REPLACE_WITH_RANDOM_PRIVATE_CONTROLLER_TOKEN
MGAR_V3_OPERATIONS_SERVICE_CONFIG=/etc/mgar-sa20/controller/components.json
MGAR_V3_ARTIFACT_ROOT=/var/lib/mgar-sa20/controller/artifacts
MGAR_V3_PROJECT_ID=REPLACE_PROJECT
MGAR_V3_REPOSITORY=owner/repository
MGAR_V3_ALLOWED_ACTORS=["owner"]
MGAR_V3_LOCAL_ACTOR=owner
MGAR_V3_WEB_PUBLIC_ORIGIN=https://magr.example.test
MGAR_V3_ALLOW_PAID=0
MGAR_V3_ALLOW_EXTERNAL_WRITE=0
