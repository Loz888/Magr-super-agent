[Unit]
Description=MGAR SA20 HTTPS public gateway without business credentials
After=network-online.target mgar-sa20-api.service mgar-sa20-source.service
Wants=network-online.target

[Service]
Type=simple
User=mgar-sa20-https
Group=mgar-sa20-https
WorkingDirectory=/opt/mgar-sa20/v3
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 PYTHONNOUSERSITE=1 /opt/mgar-sa20/v3/.venv/bin/python -m mgar_v3.super_agent.source_operations_gateway --config /etc/mgar-sa20/https/client.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
