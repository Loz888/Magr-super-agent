{
  "schema": "mgar-harness-contract-v1",
  "contract_version": "harness-contract-v1",
  "status": "FROZEN",
  "owner": "harness",
  "module_root": "src/mgar_v3/harness",
  "frozen_interfaces": {
    "TaskBinding": [],
    "CapabilityGrant": [],
    "ModelAdapter": ["complete"],
    "ToolRegistry": ["specs", "invoke"],
    "WorkspaceProvider": ["snapshot", "read", "list_dir", "apply", "diff"],
    "ExecutionBroker": ["execute"],
    "ContextManager": ["build"],
    "Verifier": ["verify"],
    "EventSink": ["emit", "events"],
    "BudgetLedger": ["reserve", "settle", "mark_unknown", "release", "snapshot"]
  },
  "advisory_interfaces": {
    "streaming_model_deltas": "H02",
    "command_job_run_poll_cancel": "H06",
    "persistent_inbox_and_safe_points": "H09",
    "context_compaction_and_paging": "H10",
    "crash_consistent_recovery": "H11",
    "remote_runner_and_multi_user": "H15-H16",
    "plugin_and_mcp_extension": "H14"
  },
  "state_ownership": {
    "session": "app.threads",
    "turn": "app.runs",
    "step": "run_events.operation_id (harness envelope)",
    "execution_epoch": "app.runs.execution_epoch",
    "budget_reservation": "Engine model/tool ledger",
    "budget_settlement": "Engine model/tool ledger",
    "finding": "existing finding store",
    "approval": "existing approval record",
    "task_status": "Engine task transaction",
    "final_completion": "Engine transaction plus verifier receipt",
    "event_cursor": "app.run_events.seq",
    "workspace_version": "WorkspaceSnapshot.tree_hash",
    "review_bundle": "existing Review Bundle service"
  },
  "not_owned": [
    "task status",
    "finding lifecycle",
    "approval decision",
    "budget settlement",
    "publication",
    "final business completion"
  ],
  "compatibility": {
    "python": ">=3.12,<3.13",
    "default_model_route": "python-kernel",
    "deepseek_harness_backend": "NOT_ADOPTED_H01",
    "deepseek_harness_probe": "NOT_RUN_NO_NODE_RUNTIME",
    "adapter_policy": "model and execution adapters are replaceable; HarnessRuntime is the only dispatcher",
    "permission_entry": "runtime precheck plus Workspace/ExecutionBroker boundary checks",
    "budget_entry": "BudgetLedger.reserve before every model and tool call",
    "unknown_outcome": "mark_unknown keeps the reservation and forbids automatic retry",
    "legacy_adapters": {
      "analysis": "mgar_v3.harness.legacy.LegacyAnalysisAdapter (read-only)",
      "repair": "mgar_v3.harness.legacy.LegacyRepairAdapter (delegates to RepairAgent)"
    }
  }
}
